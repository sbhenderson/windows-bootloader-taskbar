root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

# Source and project files keep the UTF-8 BOM; everything else inherits from [*].
[*.{cs,props,targets,csproj,wixproj,wxs,xml,config}]
charset = utf-8-bom

[*.{yml,yaml,json}]
charset = utf-8
indent_size = 2

[*.md]
charset = utf-8
trim_trailing_whitespace = false

[*.cs]
# Small collaborators (BootEntryFilter, BootTimeoutTranslator, CallerAuthorizationPolicy) are
# deliberately instance types so they can be injected and substituted in tests.
dotnet_diagnostic.CA1822.severity = suggestion

[tests/**.cs]
# Tests use descriptive snake_case names that read as sentences.
dotnet_diagnostic.CA1707.severity = none
