<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <Property Id="DOTNET_DESKTOP_RUNTIME_10_X64">
      <RegistrySearch
        Id="DotNetDesktopRuntime10X64Search"
        Root="HKLM"
        Key="SOFTWARE\dotnet\Setup\InstalledVersions\x64\sharedfx\Microsoft.WindowsDesktop.App"
        Name="10.0"
        Type="raw" />
    </Property>
  </Fragment>

  <Package
    Name="Windows Boot Switcher"
    Manufacturer="Windows Boot Switcher"
    Version="1.0.0.0"
    UpgradeCode="9E359E84-8B8E-4B6F-9B2D-0D4C1B4B9A6A"
    Scope="perMachine"
    InstallerVersion="500"
    Compressed="yes">
    <Launch
      Message="Windows Boot Switcher requires Microsoft .NET Desktop Runtime 10 (x64). Install the runtime and run setup again."
      Condition="Installed OR DOTNET_DESKTOP_RUNTIME_10_X64" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Feature Id="ProductFeature" Title="Windows Boot Switcher" Level="1">
      <ComponentRef Id="WindowsBootSwitcherServiceComponent" />
      <ComponentRef Id="TrayStartupRegistration" />
      <ComponentGroupRef Id="ServicePayload" />
      <ComponentGroupRef Id="TrayPayload" />
    </Feature>
  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Windows Boot Switcher">
        <Directory Id="SERVICEFOLDER" Name="Service" />
        <Directory Id="TRAYFOLDER" Name="Tray" />
      </Directory>
    </StandardDirectory>
  </Fragment>

  <Fragment>
    <DirectoryRef Id="SERVICEFOLDER">
      <Component Id="WindowsBootSwitcherServiceComponent" Guid="*">
        <File
          Id="WindowsBootSwitcherServiceExe"
          Source="$(var.ServicePublishDir)\WindowsBootSwitcher.Service.exe"
          KeyPath="yes" />
        <ServiceInstall
          Id="WindowsBootSwitcherServiceInstall"
          Type="ownProcess"
          Name="WindowsBootSwitcher"
          DisplayName="Windows Boot Switcher"
          Description="Runs the privileged bootloader switching service."
          Start="auto"
          Account="LocalSystem"
          ErrorControl="normal" />
        <RegistryValue
          Root="HKLM"
          Key="SYSTEM\CurrentControlSet\Services\WindowsBootSwitcher"
          Name="DelayedAutostart"
          Value="1"
          Type="integer" />
        <ServiceControl
          Id="WindowsBootSwitcherServiceControl"
          Name="WindowsBootSwitcher"
          Start="install"
          Stop="both"
          Remove="uninstall"
          Wait="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="TRAYFOLDER">
      <Component Id="TrayStartupRegistration" Guid="*">
        <RegistryValue
          Root="HKLM"
          Key="Software\Microsoft\Windows\CurrentVersion\Run"
          Name="WindowsBootSwitcherTray"
          Value="&quot;[TRAYFOLDER]WindowsBootSwitcher.Tray.exe&quot;"
          Type="string"
          KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="ServicePayload" Directory="SERVICEFOLDER">
      <Files Include="$(var.ServicePublishDir)\**">
        <Exclude Files="$(var.ServicePublishDir)\WindowsBootSwitcher.Service.exe" />
      </Files>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="TrayPayload" Directory="TRAYFOLDER">
      <Files Include="$(var.TrayPublishDir)\**" />
    </ComponentGroup>
  </Fragment>

</Wix>
