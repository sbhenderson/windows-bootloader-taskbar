    <OutputType>Exe</OutputType>
    <RootNamespace>WindowsBootSwitcher.Service</RootNamespace>
    <PublishAot>true</PublishAot>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL2104;IL3053</WarningsNotAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.0" />
    <ProjectReference Include="..\WindowsBootSwitcher.Contracts\WindowsBootSwitcher.Contracts.csproj" />
    <PackageReference Include="System.Management" Version="10.0.0" />
  </ItemGroup>
</Project>
